# Next.js env files: copy this to `.env.local` for local development.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
#
# - `.env.local` — local secrets and overrides (gitignored)
# - `NEXT_PUBLIC_*` — exposed to the browser; everything else is server-only

# Public (browser-safe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — OpenRouter (Gemini text, Grok image)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# Deprecated: image model is chosen in the UI (defaults to Riverflow 2.5). Kept for reference only.
# OPENROUTER_IMAGE_MODEL=sourceful/riverflow-v2.5-fast

# Enable mock responses when provider keys are not set
API_USE_MOCKS=false

# Story Atlas — optional public web research (Wikipedia is attempted when enabled)
# TAVILY_API_KEY=tvly-your-tavily-key
# STORY_ATLAS_DISABLE_WEB_RESEARCH=true

# API request logging in the console (default: on in development, off in production)
# API_DEBUG=true

# Public — Web3Forms (Visuai Pro "Request access" + nav Issues; browser on free plan)
# Create an access key at https://web3forms.com/ for gregmaceachern98@gmail.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
