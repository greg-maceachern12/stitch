# Next.js env files: copy this to `.env.local` for local development.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
#
# - `.env.local` — local secrets and overrides (gitignored)
# - `NEXT_PUBLIC_*` — exposed to the browser; everything else is server-only

# Public (browser-safe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (required for real AI generation)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-5.4-mini
REPLICATE_API_TOKEN=r8_your-replicate-token
REPLICATE_MODEL=google/nano-banana-2

# Enable mock responses when provider keys are not set
API_USE_MOCKS=false

# API request logging in the console (default: on in development, off in production)
# API_DEBUG=true
